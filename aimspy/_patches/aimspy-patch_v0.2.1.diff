diff --git a/src/aimspy_api/api_bank.f90 b/src/aimspy_api/api_bank.f90
new file mode 100644
index 00000000..0b39b4c5
--- /dev/null
+++ b/src/aimspy_api/api_bank.f90
@@ -0,0 +1,131 @@
+module aimspy_api_bank
+
+    use iso_c_binding
+    use mpi_utilities
+    use mpi_tasks
+    use aimspy_callback, only: TAimspyCallback
+    implicit none
+
+    logical :: aimspy_initialized = .false.
+    logical :: aimspy_converged_scf = .false.
+    logical :: aimspy_stress_ready = .false.
+
+    real*8, allocatable, target, save :: c_hamiltonian(:, :)
+    real*8, allocatable, target, save :: c_overlap(:)
+
+    type(TAimspyCallback) :: aimspy_callback_hd
+
+contains
+
+  function c_f_string(c_str) result(f_str)
+    use, intrinsic :: iso_c_binding, only: c_ptr, c_f_pointer, c_char, c_size_t, c_associated, c_null_ptr
+    type(c_ptr), intent(in) :: c_str
+    character(:, kind=c_char), pointer :: f_str
+    character(kind=c_char), pointer :: arr(:)
+
+    interface
+      function strlen(s) bind(c, name='strlen')
+        use, intrinsic :: iso_c_binding, only: c_ptr, c_size_t
+        type(c_ptr), intent(in), value :: s
+        integer(c_size_t) :: strlen
+      end function strlen
+    end interface
+
+    ! Guard against a NULL C pointer (e.g. Python passing None) — strlen(NULL)
+    ! would be undefined behavior / segfault.
+    if (.not. c_associated(c_str)) then
+      allocate(character(0) :: f_str)
+      return
+    end if
+
+    call c_f_pointer(c_str, arr, [strlen(c_str)])
+    call get_scalar_pointer(size(arr), arr, f_str)
+  end function c_f_string
+
+
+  subroutine get_scalar_pointer(scalar_len, scalar, ptr)
+    use, intrinsic :: iso_c_binding, only: c_char
+    integer, intent(in) :: scalar_len
+    character(kind=c_char, len=scalar_len), intent(in), target :: scalar(1)
+    character(:, kind=c_char), intent(out), pointer :: ptr
+
+    ptr => scalar(1)
+  end subroutine get_scalar_pointer
+
+  type(c_ptr) function c_rs_hamiltonian() bind(c, name='c_rs_hamiltonian')
+    implicit none
+
+    !write(*, '(A)') "get c_rs_hamiltonian"
+    if (myid==0) then
+      c_rs_hamiltonian = c_loc(c_hamiltonian) 
+    else
+      c_rs_hamiltonian = c_null_ptr
+    end if
+  end function c_rs_hamiltonian
+
+  type(c_ptr) function c_rs_overlap() bind(c, name='c_rs_overlap')
+    implicit none
+
+    !write(*, '(A)') "get c_rs_overlap"
+    if (myid==0) then
+      c_rs_overlap = c_loc(c_overlap) 
+    else
+      c_rs_overlap = c_null_ptr
+    end if
+  end function c_rs_overlap
+
+  real*8 function aimspy_energy() bind(c, name='aimspy_energy')
+    use physics, only: total_energy, post_scf_total_energy
+    implicit none
+
+    if (post_scf_total_energy /= 0.0d0) then
+      aimspy_energy = post_scf_total_energy
+    else
+      aimspy_energy = total_energy
+    end if
+  end function aimspy_energy
+
+  real*8 function aimspy_energy_raw() bind(c, name='aimspy_energy_raw')
+    use physics, only: total_energy
+    implicit none
+
+    aimspy_energy_raw = total_energy
+  end function aimspy_energy_raw
+
+  real*8 function aimspy_energy_free() bind(c, name='aimspy_energy_free')
+    use physics, only: total_energy, entropy_correction
+    implicit none
+
+    ! Variational electronic free energy.  Its negative coordinate derivative
+    ! gives the uncleaned total forces, so this is the force-consistent scalar
+    ! to use for conservative machine-learning potentials.
+    aimspy_energy_free = total_energy + 2.0d0 * entropy_correction
+  end function aimspy_energy_free
+
+  type(c_ptr) function aimspy_forces() bind(c, name='aimspy_forces')
+    use physics, only: total_forces  ! shape (3, natoms) in fortran
+    use dimensions, only: use_forces
+    implicit none
+
+    if (use_forces) then
+      aimspy_forces = c_loc(total_forces)
+    else
+      aimspy_forces = c_null_ptr
+    end if
+
+  end function aimspy_forces
+
+  type(c_ptr) function aimspy_stress() bind(c, name='aimspy_stress')
+    use analytical_stress, only: analytical_stress_tensor
+    implicit none
+
+    ! The tensor is the final analytical stress in Hartree/Bohr^3.  Read the
+    ! physical result directly and use AimSpy-owned lifecycle state.
+    if (aimspy_stress_ready) then
+      aimspy_stress = c_loc(analytical_stress_tensor(1, 1))
+    else
+      aimspy_stress = c_null_ptr
+    end if
+  end function aimspy_stress
+
+end module aimspy_api_bank
diff --git a/src/aimspy_api/callback.f90 b/src/aimspy_api/callback.f90
new file mode 100644
index 00000000..8b9d02f6
--- /dev/null
+++ b/src/aimspy_api/callback.f90
@@ -0,0 +1,651 @@
+module aimspy_callback
+
+    use iso_c_binding
+    implicit none
+    private
+
+    public :: TAimspyCallback
+    public :: TAimspyCsrMxDescr
+    public :: TAimspyGridDescr
+    public :: TAimspyBasisDescr
+    public :: grid_descr_storage
+    public :: basis_descr_storage
+
+
+        type, bind(c) :: TAimspyCsrMxDescr
+            integer(c_int) :: n_basis
+            integer(c_int) :: n_spin
+            integer(c_int) :: n_cells
+            integer(c_int) :: n_ham_size ! nnz + 1
+            integer(c_int) :: n_cells_array ! actual size of cell_index array (may be > n_cells)
+
+            type(c_ptr)  :: cell_idx     = c_null_ptr  ! cell_index, shape (n_cells_array, n_coords), n_coords = 3
+            type(c_ptr)  :: row_mx_idx   = c_null_ptr  ! index_hamiltonian, shape (2, n_cells, n_basis)
+            type(c_ptr)  :: col_mx_idx   = c_null_ptr  ! column_index_hamiltonian, shape (n_ham_size)
+        end type TAimspyCsrMxDescr
+
+        ! Descriptor for the real-space integration grid (per MPI rank).
+        ! Field order MUST match the Python-side ctypes.Structure mirror
+        ! exactly (see pyapi/aimspy/_binding/ctypes_types.py GridDescrC).
+        ! Physical arrays (rho / vks / vks0 / vh / vh0 / rho0) are passed as
+        ! separate callback arguments, NOT through this descriptor.
+        type, bind(c) :: TAimspyGridDescr
+            integer(c_int) :: n_full_points   ! grid points owned by this rank
+            integer(c_int) :: n_spin
+            integer(c_int) :: n_atoms
+            integer(c_int) :: n_my_batches
+            integer(c_int) :: myid            ! MPI rank owning this subset
+
+            type(c_ptr)  :: coords_ptr        = c_null_ptr  ! (3, n_full_points) bohr
+            type(c_ptr)  :: partition_tab_ptr = c_null_ptr  ! (n_full_points) bohr^3
+            type(c_ptr)  :: index_atom_ptr    = c_null_ptr  ! (n_full_points) int, 1-based
+            type(c_ptr)  :: index_radial_ptr  = c_null_ptr  ! (n_full_points) int, 1-based
+            type(c_ptr)  :: index_angular_ptr = c_null_ptr  ! (n_full_points) int, 1-based
+        end type TAimspyGridDescr
+
+        ! Descriptor for the NAO radial basis set (species-level, static).
+        ! Field order MUST match the Python-side ctypes.Structure mirror
+        ! exactly (see pyapi/aimspy/_binding/ctypes_types.py BasisDescrC).
+        ! Spline coefficient arrays and grid parameters are passed as
+        ! separate callback arguments, NOT through this descriptor.
+        type, bind(c) :: TAimspyBasisDescr
+            integer(c_int) :: n_species        ! number of species
+            integer(c_int) :: n_basis_fns      ! total radial functions (all species)
+            integer(c_int) :: n_max_grid       ! max grid points across species
+            integer(c_int) :: n_max_spline     ! always 4 (cubic)
+            integer(c_int) :: total_grid_points ! sum of n_grid over species
+
+            type(c_ptr)  :: r_grid_min_ptr    = c_null_ptr  ! (n_species,) bohr
+            type(c_ptr)  :: r_grid_inc_ptr    = c_null_ptr  ! (n_species,)
+            type(c_ptr)  :: n_grid_ptr        = c_null_ptr  ! (n_species,) int
+            type(c_ptr)  :: r_grid_ptr        = c_null_ptr  ! (total_grid_points,) bohr
+            type(c_ptr)  :: outer_radius_ptr  = c_null_ptr  ! (n_basis_fns,) bohr
+        end type TAimspyBasisDescr
+
+        type :: TAimspyCallback
+            
+            type(c_ptr), private :: descr_ptr  = c_null_ptr ! TAimspyCsrMxDescr ptr
+
+            ! ============== [1]. callback functions pointers and aux pointers ===========
+            ! get mx descripter
+            type(c_funptr), private :: get_descr_callback = c_null_funptr
+            type(c_ptr), private    :: get_descr_aux_ptr  = c_null_ptr
+
+            ! export S
+            type(c_funptr), private :: export_ovlp_callback = c_null_funptr
+            type(c_ptr), private    :: export_ovlp_aux_ptr  = c_null_ptr
+
+            ! export H0
+            type(c_funptr), private :: export_h0_callback = c_null_funptr
+            type(c_ptr), private    :: export_h0_aux_ptr  = c_null_ptr
+
+            ! modify H0
+            type(c_funptr), private :: modify_h0_callback = c_null_funptr
+            type(c_ptr), private    :: modify_h0_aux_ptr  = c_null_ptr
+            type(c_ptr), private    :: modify_h0_input_mx_ptr   = c_null_ptr        ! c_ptr of double
+            logical        :: modify_h0_registered = .false.
+
+            ! only python callback
+            type(c_funptr), private :: python_callback = c_null_funptr
+            type(c_ptr), private    :: python_aux_ptr  = c_null_ptr
+
+            ! export electric response first-order hamiltonian (dH/de)
+            type(c_funptr), private :: export_dHde_callback = c_null_funptr
+            type(c_ptr),    private :: export_dHde_aux_ptr  = c_null_ptr
+
+            ! modify dH/de (replace)
+            type(c_funptr), private :: modify_dHde_callback = c_null_funptr
+            type(c_ptr),    private :: modify_dHde_aux_ptr  = c_null_ptr
+            type(c_ptr),    private :: modify_dHde_input_mx_ptr = c_null_ptr
+            logical,        public  :: modify_dHde_registered = .false.
+
+            ! export real-space grid data (rho / V_KS / V_KS_0 / ...)
+            type(c_funptr), private :: export_grid_data_callback = c_null_funptr
+            type(c_ptr),    private :: export_grid_data_aux_ptr  = c_null_ptr
+
+            ! export NAO radial basis data (spline coefficients, grid params, ...)
+            type(c_funptr), private :: export_basis_data_callback = c_null_funptr
+            type(c_ptr),    private :: export_basis_data_aux_ptr  = c_null_ptr
+            logical,        public  :: export_basis_data_registered = .false.
+
+
+          contains
+            ! ============== [2]. register methods and calling functins ==================
+            procedure :: register_get_descr
+            procedure :: get_descr_func
+
+            procedure :: register_export_ovlp
+            procedure :: export_ovlp_func
+
+            procedure :: register_export_h0
+            procedure :: export_h0_func
+
+            procedure :: register_modify_h0
+            procedure :: modify_h0_func
+
+            procedure :: register_python_callback
+            procedure :: python_func
+
+            procedure :: register_export_dHde
+            procedure :: export_dHde_func
+
+            procedure :: register_modify_dHde
+            procedure :: modify_dHde_func
+
+            procedure :: register_export_grid_data
+            procedure :: export_grid_data_func
+
+            procedure :: register_export_basis_data
+            procedure :: export_basis_data_func
+
+            procedure :: reset_all
+
+            ! ========================= end [1]. [2]. ====================================
+
+        end type TAimspyCallback
+
+        ! ============== [3]. interface about the callback c function ==================
+        abstract interface
+            subroutine aimspy_get_descr_cb_t(aux_ptr, descr_ptr) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr  ! same type as descr but from python
+                type(c_ptr), value :: descr_ptr
+            end subroutine
+        end interface
+
+        abstract interface
+            subroutine aimspy_export_mx_cb_t(aux_ptr, mx_ptr, n_ham_size, n_spin) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: mx_ptr
+                integer(c_int), value :: n_ham_size
+                integer(c_int), value :: n_spin
+            end subroutine
+        end interface
+
+        abstract interface
+            subroutine aimspy_modify_mx_cb_t(aux_ptr, input_mx_ptr, modified_mx_ptr, n_ham_size, n_spin) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: input_mx_ptr
+                type(c_ptr), value :: modified_mx_ptr
+                integer(c_int), value :: n_ham_size
+                integer(c_int), value :: n_spin
+            end subroutine aimspy_modify_mx_cb_t
+        end interface
+
+        abstract interface
+            subroutine aimspy_python_cb_t(aux_ptr) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+            end subroutine aimspy_python_cb_t
+        end interface
+
+        ! ---- dHde export: fires after CPSCF convergence ----
+        abstract interface
+            subroutine aimspy_export_dHde_cb_t(aux_ptr, mx_ptr, n_ham_size, n_dir, n_spin, j_coord) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: mx_ptr          ! c_loc(DFPT_first_order_H_sparse(1,1,1,1))
+                integer(c_int), value :: n_ham_size   ! n_hamiltonian_matrix_size (per direction)
+                integer(c_int), value :: n_dir        ! 1 (serial) or 3 (full-memory)
+                integer(c_int), value :: n_spin        ! 1 or 2
+                integer(c_int), value :: j_coord       ! 0=all (full-memory); 1=x,2=y,3=z (serial)
+            end subroutine aimspy_export_dHde_cb_t
+        end interface
+
+        ! ---- dHde modify: fires before initial U1 computation ----
+        abstract interface
+            subroutine aimspy_modify_dHde_cb_t(aux_ptr, input_mx_ptr, modified_mx_ptr, n_ham_size, n_dir, n_spin, j_coord) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: input_mx_ptr     ! Python-provided buffer (flat, Fortran-order)
+                type(c_ptr), value :: modified_mx_ptr  ! c_loc(DFPT_first_order_H_sparse(1,1,1,1))
+                integer(c_int), value :: n_ham_size
+                integer(c_int), value :: n_dir
+                integer(c_int), value :: n_spin
+                integer(c_int), value :: j_coord
+            end subroutine aimspy_modify_dHde_cb_t
+        end interface
+
+        ! ---- export_grid_data: fires once after SCF convergence (per rank) ----
+        ! Physical arrays are passed as separate c_ptr arguments (read-only,
+        ! intent(in)).  Shapes (all Fortran column-major):
+        !   rho / vks / vks0 : (n_spin, n_full_points)
+        !   vh / vh0 / rho0  : (n_full_points)   [rho0 = free_rho_superpos = 4*pi*rho_0]
+        abstract interface
+            subroutine aimspy_export_grid_cb_t(aux_ptr, descr_ptr, &
+                rho_ptr, vks_ptr, vks0_ptr, vh_ptr, vh0_ptr, rho0_ptr) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: descr_ptr  ! TAimspyGridDescr
+                type(c_ptr), value :: rho_ptr
+                type(c_ptr), value :: vks_ptr
+                type(c_ptr), value :: vks0_ptr
+                type(c_ptr), value :: vh_ptr
+                type(c_ptr), value :: vh0_ptr
+                type(c_ptr), value :: rho0_ptr
+            end subroutine aimspy_export_grid_cb_t
+        end interface
+
+        ! ---- export_basis_data: fires once after shrink_fixed_basis_phi_thresh ----
+        ! Spline coefficient arrays are passed as separate c_ptr arguments.
+        ! Shapes (all Fortran column-major flat buffers):
+        !   wave_spl / kinetic_spl / deriv_spl : (n_max_spline, n_max_grid, n_basis_fns)
+        ! Grid parameter arrays:
+        !   r_grid_min / r_grid_inc : (n_species,)
+        !   n_grid : (n_species,) int
+        !   r_grid : (total_grid_points,)
+        !   outer_radius : (n_basis_fns,)
+        abstract interface
+            subroutine aimspy_export_basis_cb_t(aux_ptr, descr_ptr, &
+                wave_spl_ptr, kinetic_spl_ptr, deriv_spl_ptr) bind(c)
+                use iso_c_binding
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: descr_ptr  ! TAimspyBasisDescr
+                type(c_ptr), value :: wave_spl_ptr
+                type(c_ptr), value :: kinetic_spl_ptr
+                type(c_ptr), value :: deriv_spl_ptr
+            end subroutine aimspy_export_basis_cb_t
+        end interface
+
+        ! =================== end [3]. ======================================
+
+        type(TAimspyCsrMxDescr), target :: descr_storage
+        type(TAimspyGridDescr), target :: grid_descr_storage
+        type(TAimspyBasisDescr), target :: basis_descr_storage
+
+    contains
+            
+            ! ============== [2]. register methods and calling functins ==================
+            subroutine fill_mx_descr(descr)
+                use iso_c_binding
+                use dimensions, only: n_basis, n_spin, n_hamiltonian_matrix_size
+                use pbc_lists, only: n_cells_in_hamiltonian, cell_index, index_hamiltonian, column_index_hamiltonian
+                type(TAimspyCsrMxDescr), intent(inout) :: descr
+
+                descr%n_basis = int(n_basis, c_int)
+                descr%n_spin = int(n_spin, c_int)
+                descr%n_cells = int(n_cells_in_hamiltonian, c_int)
+                descr%n_ham_size = int(n_hamiltonian_matrix_size, c_int)
+
+                ! cell_index is allocated as cell_index(n_cells_new, 3), where
+                ! n_cells_new >= n_cells_in_hamiltonian. We report the actual
+                ! array size so Python can read with the correct column-major
+                ! stride, then slice to the first n_cells_in_hamiltonian entries.
+                if (allocated(cell_index)) then
+                    descr%n_cells_array = int(size(cell_index, 1), c_int)
+                else
+                    descr%n_cells_array = 0
+                end if
+
+                ! Guard each c_loc with allocated() to avoid UB when the
+                ! PBC list arrays are not yet set up (e.g. cluster mode or
+                ! early call before PBC initialization).
+                if (allocated(cell_index)) then
+                    descr%cell_idx = c_loc(cell_index(1,1))
+                else
+                    descr%cell_idx = c_null_ptr
+                end if
+                if (allocated(index_hamiltonian)) then
+                    descr%row_mx_idx = c_loc(index_hamiltonian(1,1,1))
+                else
+                    descr%row_mx_idx = c_null_ptr
+                end if
+                if (allocated(column_index_hamiltonian)) then
+                    descr%col_mx_idx = c_loc(column_index_hamiltonian(1))
+                else
+                    descr%col_mx_idx = c_null_ptr
+                end if
+
+            end subroutine fill_mx_descr
+
+            subroutine register_get_descr(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+
+                this%get_descr_callback = callback_funptr
+                this%get_descr_aux_ptr = aux_ptr
+
+            end subroutine register_get_descr
+
+            subroutine get_descr_func(this)
+                use iso_c_binding
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                procedure(aimspy_get_descr_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%get_descr_callback)) then
+                    return
+                end if
+
+                if (.not. c_associated(this%descr_ptr)) then
+                    this%descr_ptr = c_loc(descr_storage)
+                end if
+
+                call c_f_procpointer(this%get_descr_callback, callback_proc)
+                call fill_mx_descr(descr_storage)
+                call callback_proc(this%get_descr_aux_ptr, this%descr_ptr)
+
+            end subroutine get_descr_func
+
+            subroutine register_export_ovlp(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+
+                this%export_ovlp_callback = callback_funptr
+                this%export_ovlp_aux_ptr = aux_ptr
+
+            end subroutine register_export_ovlp
+
+            subroutine export_ovlp_func(this, overlap_matrix)
+                use iso_c_binding
+                use dimensions, only: n_hamiltonian_matrix_size
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(in), target, contiguous :: overlap_matrix(:)
+                procedure(aimspy_export_mx_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%export_ovlp_callback)) then
+                    return
+                end if
+
+                call c_f_procpointer(this%export_ovlp_callback, callback_proc)
+                call callback_proc(this%export_ovlp_aux_ptr, &
+                                  c_loc(overlap_matrix(1)), &
+                                  int(n_hamiltonian_matrix_size, c_int), &
+                                  1)
+            end subroutine export_ovlp_func
+
+            subroutine register_export_h0(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+
+                this%export_h0_callback = callback_funptr
+                this%export_h0_aux_ptr = aux_ptr
+
+            end subroutine register_export_h0
+
+            subroutine export_h0_func(this, init_hamiltonian)
+                use iso_c_binding
+                use dimensions, only: n_hamiltonian_matrix_size, n_spin
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(in), target, contiguous :: init_hamiltonian(:, :)
+                procedure(aimspy_export_mx_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%export_h0_callback)) then
+                    return
+                end if
+
+                call c_f_procpointer(this%export_h0_callback, callback_proc)
+                call callback_proc(this%export_h0_aux_ptr, &
+                                  c_loc(init_hamiltonian(1,1)), &
+                                  int(n_hamiltonian_matrix_size, c_int), &
+                                  int(n_spin, c_int))
+            end subroutine export_h0_func
+
+            subroutine register_modify_h0(this, callback_funptr, aux_ptr, input_mx_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: input_mx_ptr
+
+                this%modify_h0_callback = callback_funptr
+                this%modify_h0_aux_ptr = aux_ptr
+                this%modify_h0_input_mx_ptr = input_mx_ptr
+                this%modify_h0_registered = .true.
+            end subroutine register_modify_h0
+
+            subroutine modify_h0_func(this, init_hamiltonian)
+                use iso_c_binding
+                use dimensions, only: n_hamiltonian_matrix_size, n_spin
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(inout), target, contiguous :: init_hamiltonian(:, :)
+                procedure(aimspy_modify_mx_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%modify_h0_callback)) then
+                    return
+                end if
+
+                call c_f_procpointer(this%modify_h0_callback, callback_proc)
+                call callback_proc(this%modify_h0_aux_ptr, &
+                                   this%modify_h0_input_mx_ptr, &
+                                  c_loc(init_hamiltonian(1,1)), &
+                                  int(n_hamiltonian_matrix_size, c_int), &
+                                  int(n_spin, c_int))
+            end subroutine modify_h0_func
+
+            subroutine register_python_callback(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+
+                this%python_callback = callback_funptr
+                this%python_aux_ptr = aux_ptr
+            end subroutine register_python_callback
+
+            subroutine python_func(this)
+                use iso_c_binding
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                procedure(aimspy_python_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%python_callback)) then
+                    return
+                end if
+
+                call c_f_procpointer(this%python_callback, callback_proc)
+                call callback_proc(this%python_aux_ptr)
+            end subroutine python_func
+
+
+            subroutine register_export_dHde(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+                this%export_dHde_callback = callback_funptr
+                this%export_dHde_aux_ptr  = aux_ptr
+            end subroutine register_export_dHde
+
+            subroutine export_dHde_func(this, first_order_H_sparse, n_dir, j_coord)
+                use iso_c_binding
+                use dimensions, only: n_hamiltonian_matrix_size, n_spin
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(in), target, contiguous :: first_order_H_sparse(:,:,:,:)
+                ! shape (n_dir, 1, n_hamiltonian_matrix_size, n_spin)
+                integer, intent(in) :: n_dir, j_coord
+                procedure(aimspy_export_dHde_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%export_dHde_callback)) return
+
+                call c_f_procpointer(this%export_dHde_callback, callback_proc)
+                call callback_proc(this%export_dHde_aux_ptr, &
+                                c_loc(first_order_H_sparse(1,1,1,1)), &
+                                int(n_hamiltonian_matrix_size, c_int), &
+                                int(n_dir, c_int), &
+                                int(n_spin, c_int), &
+                                int(j_coord, c_int))
+            end subroutine export_dHde_func
+
+            subroutine register_modify_dHde(this, callback_funptr, aux_ptr, input_mx_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+                type(c_ptr), value :: input_mx_ptr
+                this%modify_dHde_callback = callback_funptr
+                this%modify_dHde_aux_ptr  = aux_ptr
+                this%modify_dHde_input_mx_ptr = input_mx_ptr
+                this%modify_dHde_registered = .true.
+            end subroutine register_modify_dHde
+
+            subroutine modify_dHde_func(this, first_order_H_sparse, n_dir, j_coord)
+                use iso_c_binding
+                use dimensions, only: n_hamiltonian_matrix_size, n_spin
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(inout), target, contiguous :: first_order_H_sparse(:,:,:,:)
+                integer, intent(in) :: n_dir, j_coord
+                procedure(aimspy_modify_dHde_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%modify_dHde_callback)) return
+
+                call c_f_procpointer(this%modify_dHde_callback, callback_proc)
+                call callback_proc(this%modify_dHde_aux_ptr, &
+                                this%modify_dHde_input_mx_ptr, &
+                                c_loc(first_order_H_sparse(1,1,1,1)), &
+                                int(n_hamiltonian_matrix_size, c_int), &
+                                int(n_dir, c_int), &
+                                int(n_spin, c_int), &
+                                int(j_coord, c_int))
+            end subroutine modify_dHde_func
+
+            subroutine register_export_grid_data(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+                this%export_grid_data_callback = callback_funptr
+                this%export_grid_data_aux_ptr  = aux_ptr
+            end subroutine register_export_grid_data
+
+            ! Fire the export_grid_data callback.  The descriptor is filled by
+            ! the caller (aimspy_export_grid_data module) before invoking this
+            ! via export_grid_data_func.  All physical arrays are read-only.
+            subroutine export_grid_data_func(this, rho, vks, vks0, vh, vh0, rho0)
+                use iso_c_binding
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(in), target, contiguous :: rho(:,:)
+                real*8, intent(in), target, contiguous :: vks(:,:)
+                real*8, intent(in), target, contiguous :: vks0(:,:)
+                real*8, intent(in), target, contiguous :: vh(:)
+                real*8, intent(in), target, contiguous :: vh0(:)
+                real*8, intent(in), target, contiguous :: rho0(:)
+                procedure(aimspy_export_grid_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%export_grid_data_callback)) return
+
+                call c_f_procpointer(this%export_grid_data_callback, callback_proc)
+                call callback_proc(this%export_grid_data_aux_ptr, &
+                                c_loc(grid_descr_storage), &
+                                c_loc(rho(1,1)), &
+                                c_loc(vks(1,1)), &
+                                c_loc(vks0(1,1)), &
+                                c_loc(vh(1)), &
+                                c_loc(vh0(1)), &
+                                c_loc(rho0(1)))
+            end subroutine export_grid_data_func
+
+            subroutine register_export_basis_data(this, callback_funptr, aux_ptr)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                type(c_funptr), value :: callback_funptr
+                type(c_ptr), value :: aux_ptr
+                this%export_basis_data_callback = callback_funptr
+                this%export_basis_data_aux_ptr  = aux_ptr
+                this%export_basis_data_registered = .true.
+            end subroutine register_export_basis_data
+
+            ! Fire the export_basis_data callback.  The descriptor is filled by
+            ! the caller (aimspy_export_basis_data module) before invoking this.
+            subroutine export_basis_data_func(this, r_grid_min, r_grid_inc, n_grid_arr, &
+                                              r_grid_arr, outer_radius_arr, &
+                                              wave_spl, kinetic_spl, deriv_spl)
+                use iso_c_binding
+                use dimensions, only: n_species, n_basis_fns, n_max_grid, n_max_spline
+                use grids, only: n_grid
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+                real*8, intent(in), target, contiguous :: r_grid_min(:)
+                real*8, intent(in), target, contiguous :: r_grid_inc(:)
+                integer(c_int), intent(in), target, contiguous :: n_grid_arr(:)
+                real*8, intent(in), target, contiguous :: r_grid_arr(:)
+                real*8, intent(in), target, contiguous :: outer_radius_arr(:)
+                real*8, intent(in), target, contiguous :: wave_spl(:)
+                real*8, intent(in), target, contiguous :: kinetic_spl(:)
+                real*8, intent(in), target, contiguous :: deriv_spl(:)
+                procedure(aimspy_export_basis_cb_t), pointer :: callback_proc
+
+                if (.not. c_associated(this%export_basis_data_callback)) return
+
+                ! Fill descriptor
+                basis_descr_storage%n_species         = int(n_species, c_int)
+                basis_descr_storage%n_basis_fns       = int(n_basis_fns, c_int)
+                basis_descr_storage%n_max_grid        = int(n_max_grid, c_int)
+                basis_descr_storage%n_max_spline      = int(n_max_spline, c_int)
+                basis_descr_storage%total_grid_points = int(sum(n_grid(1:n_species)), c_int)
+
+                basis_descr_storage%r_grid_min_ptr   = c_loc(r_grid_min(1))
+                basis_descr_storage%r_grid_inc_ptr   = c_loc(r_grid_inc(1))
+                basis_descr_storage%n_grid_ptr       = c_loc(n_grid_arr(1))
+                basis_descr_storage%r_grid_ptr       = c_loc(r_grid_arr(1))
+                basis_descr_storage%outer_radius_ptr = c_loc(outer_radius_arr(1))
+
+                call c_f_procpointer(this%export_basis_data_callback, callback_proc)
+                call callback_proc(this%export_basis_data_aux_ptr, &
+                                c_loc(basis_descr_storage), &
+                                c_loc(wave_spl(1)), &
+                                c_loc(kinetic_spl(1)), &
+                                c_loc(deriv_spl(1)))
+            end subroutine export_basis_data_func
+
+            ! Reset all registered callbacks, aux pointers, input pointers,
+            ! and registered-flags.  Called from aimspy_finalize (and exposed
+            ! via aimspy_reset_callbacks) so that a second Calculator in the
+            ! same process never calls a dangling Python function pointer
+            ! left over from a previous Calculator.
+            subroutine reset_all(this)
+                implicit none
+                class(TAimspyCallback), intent(inout) :: this
+
+                this%descr_ptr = c_null_ptr
+
+                this%get_descr_callback = c_null_funptr
+                this%get_descr_aux_ptr  = c_null_ptr
+
+                this%export_ovlp_callback = c_null_funptr
+                this%export_ovlp_aux_ptr  = c_null_ptr
+
+                this%export_h0_callback = c_null_funptr
+                this%export_h0_aux_ptr  = c_null_ptr
+
+                this%modify_h0_callback = c_null_funptr
+                this%modify_h0_aux_ptr  = c_null_ptr
+                this%modify_h0_input_mx_ptr = c_null_ptr
+                this%modify_h0_registered = .false.
+
+                this%python_callback = c_null_funptr
+                this%python_aux_ptr  = c_null_ptr
+
+                this%export_dHde_callback = c_null_funptr
+                this%export_dHde_aux_ptr  = c_null_ptr
+
+                this%modify_dHde_callback = c_null_funptr
+                this%modify_dHde_aux_ptr  = c_null_ptr
+                this%modify_dHde_input_mx_ptr = c_null_ptr
+                this%modify_dHde_registered = .false.
+
+                this%export_grid_data_callback = c_null_funptr
+                this%export_grid_data_aux_ptr  = c_null_ptr
+
+                this%export_basis_data_callback = c_null_funptr
+                this%export_basis_data_aux_ptr  = c_null_ptr
+                this%export_basis_data_registered = .false.
+
+            end subroutine reset_all
+
+
+end module aimspy_callback
