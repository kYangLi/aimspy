+
+               ! 1. Python memmove → DFPT_first_order_H_sparse
+               call aimspy_callback_hd%modify_dHde_func( &
+                     DFPT_first_order_H_sparse, n_dfpt_coords, aimspy_current_dfpt_coord)
+               write (info_str,'(A,2X)') & 
+               "First order Hamiltonian matrix modified done."
+               call localorb_info(info_str,use_unit,'(A)')
+
+               ! 2. Convert sparse → ScaLAPACK/dense (so evaluate_U1 can read it)
+               !    Mirrors DFPT_calc_H1 lines 2534-2593
+               coord_counter = 0
