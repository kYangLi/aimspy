+                                 else
+                                    call construct_scalapack_matrix_from_sparse( &
+                                       DFPT_first_order_H_sparse(coord_counter,1,:,i_spin), &
+                                       DFPT_first_order_H_scalapack(1,1,:,:,1), &
+                                       DFPT_first_order_H_complex_scalapack(coord_counter,1,:,:,i_spin))
+                                 endif
+                           else
+                                 ! LAPACK
+                                 i_k_task = 0
+                                 do i_k_point = 1,n_k_points, 1
+                                    if (myid.eq.  MOD(i_k_point, n_tasks) .and. myid <= n_k_points ) then
+                                       i_k_task = i_k_task + 1
+                                    
+                                       if (real_eigenvectors) then
+                                          call construct_real_dense_matrix_from_sparse(DFPT_first_order_H_sparse(coord_counter,1,:,i_spin), &
+                                             DFPT_first_order_H(coord_counter,1,1:n_basis,1:n_basis,i_k_task,i_spin), i_k_point)
+                                       else
+                                          call construct_dense_matrix_from_sparse(DFPT_first_order_H_sparse(coord_counter,1,:,i_spin), &
+                                             DFPT_first_order_H_complex(coord_counter,1,1:n_basis,1:n_basis,i_k_task,i_spin), i_k_point)
+                                       endif ! real_eig
+                                    endif ! myid
+                                 enddo ! n_k_point
+                           endif ! scalapack
+                        enddo ! i_spin
